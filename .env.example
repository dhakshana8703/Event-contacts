# ==============================================================================
# Nunify Event Intelligence Pipeline - Environment Configuration Template
# ==============================================================================
# This is a public template. DO NOT put actual secret keys in this file.
# Put your real API keys in .env (which is protected by .gitignore).

# Live Search Provider (Required for Stage 3 LinkedIn Discovery)
# Serper.dev: 2,500 free Google searches on signup (https://serper.dev)
SERPER_API_KEY=

# Tavily AI: 1,000 free agent searches/month (https://tavily.com)
TAVILY_API_KEY=

# LLM Reasoning Provider (Required for Stage 2 Contact Extraction)
# Google AI Studio: Free tier 1,500 requests/day (https://aistudio.google.com)
GEMINI_API_KEY=

# NVIDIA NIM: 1,000 free credits on signup (https://build.nvidia.com)
NVIDIA_API_KEY=

# Groq: Free tier fast inference (https://console.groq.com)
GROQ_API_KEY=
